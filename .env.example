# Скопировать в .env
ALLOW_EMAIL_CHANGE=0
# 1 = headless (по умолчанию); 0 = видимое окно только для отладки
HEADLESS=1
# Оптимизация Camoufox включена по умолчанию (порт Node-бустера).
# Раскомментируйте и поставьте 0, чтобы выключить.
# CAMOUFOX_BLOCK_RESOURCES=1
# CAMOUFOX_HUMANIZE=1
SITEKEY=b3c619fc-4b72-4838-9bf2-398888588d62
HOST=account.riotgames.com
ACCOUNTS_FILE=data/input/accounts.json
CAPTCHA_TIMEOUT=150

# --- cookie_extractor.py ---
# COOKIES_FILE=data/input/accounts.jsonl
# PROXY=http://user:pass@1.2.3.4:1080
# PROXY_POOL=data/input/proxies-top.txt
# PROXY_TEST_URL=https://account.riotgames.com/
# COOKIE_DOMAIN=riotgames.com
# SESSION_COOKIE=ssid
# LOGIN_URL=https://account.riotgames.com/

# --- server.py ---
BIND_HOST=127.0.0.1
PORT=8000
# Docker: compose сам ставит BIND_HOST=0.0.0.0. Это только порт на хосте.
# RIOT_PORT=8000
# DOCKER_MAX_WORKERS=4
# DOCKER_MIN_FREE_MB=1024
# API_KEY=change-me
# API_KEYS={"key-for-client1":"client1","key-for-client2":"client2"}
MAX_WORKERS=5
# MAX_PER_CLIENT=0
MAX_QUEUE=5000
BATCH_MAX=500
JOB_ATTEMPTS=3
RETRY_BASE=30
RAMP_INTERVAL=1.0
MIN_FREE_MB=2048
RATE_LIMIT_PER_MIN=1200
JOBS_DB=data/jobs.sqlite3
ENABLE_SYNC_RUN=0
ENABLE_DOCS=0
SHUTDOWN_TIMEOUT=10
# RUN_TIMEOUT=0
# LOG_LEVEL=INFO

# Разрешить job/run без proxy (только для локальных тестов!)
# ALLOW_NO_PROXY=0
# Разрешить test_mode: несколько job на одном proxy (только для тестов!)
# ALLOW_SHARED_PROXY_TEST=0
# Домены, которые отклоняются до запуска браузера:
# BLOCKED_EMAIL_DOMAINS=outlook.com,hotmail.com

# --- webhooks (опционально) ---
# Общий fallback: используется, если клиент не передал webhook_url в job'е.
# WEBHOOK_URL=https://client.example/hook
# WEBHOOK_SECRET=change-me
# WEBHOOK_TIMEOUT=5
# WEBHOOK_RETRIES=3
# Пусто = /api/v1/webhook пишет в data/output/webhook-results.jsonl.
# Задайте, только если нужен отдельный локальный приёмник:
# WEBHOOK_PROXY_URL=http://127.0.0.1:9000/hook
